    "worker": "node worker.js",
    "kirim": "node producer.js",
    "status": "node tools/status.js",
    "cek": "node tools/cek.js",
    "uji": "node tools/uji.js",
    "test": "node --test test/kontrak.test.js"
  },
  "dependencies": {
    "amqplib": "^0.10.9",
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=20.6"
  }
