{
  "name": "a05-tiket-bantuan",
  "version": "1.0.0",
  "private": true,
  "description": "Capstone MP-11 kasus A05: klasifikasi deterministik dan penugasan tiket bantuan melalui RabbitMQ work queue (data sintetis).",
  "scripts": {
