# Opsional. Salin ke .env hanya bila perlu mengubah nilai bawaan:
#   cp .env.contoh .env
# Nilai bawaan kode sudah cocok dengan compose.yml (kredensial dummy lokal).

AMQP_URL=amqp://simpel:simpel123@localhost:5673
DATABASE_URL=postgres://simpel:simpel123@localhost:5442/tiket

# Management API, hanya untuk membaca jumlah unacked sebagai bukti.
RABBITMQ_MGMT_URL=http://localhost:15673
RABBITMQ_USER=simpel
RABBITMQ_PASS=simpel123
RABBITMQ_VHOST=/

# Worker
WORKER_PREFETCH=4
# Jeda simulasi kerja per tiket (ms). 0 = secepatnya.
WORKER_WORK_MS=0

# Memakai broker cadangan terpusat? Ganti AMQP_URL dengan alamat dari panitia.
# Jangan commit file .env.
